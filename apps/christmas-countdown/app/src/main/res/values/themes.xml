<resources>
    <!-- Splash screen (Android 12+ style, back-ported by core-splashscreen). -->
    <style name="Theme.ChristmasCountdown.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night_top</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ChristmasCountdown</item>
    </style>

    <style name="Theme.ChristmasCountdown" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_top</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
