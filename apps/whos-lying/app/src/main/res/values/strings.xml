    <!-- How to play -->
    <string name="how_1_title">1 · Get your word</string>
    <string name="how_1">Pass the phone around. Everyone sees the same secret word… except the impostors.</string>
    <string name="how_2_title">2 · Give clues</string>
    <string name="how_2">In turns, say one word or short phrase about it. Not too obvious, or the impostor will catch on.</string>
    <string name="how_3_title">3 · Vote</string>
    <string name="how_3">Discuss and vote someone out. The app reveals what they were.</string>
    <string name="how_4_title">4 · Win</string>
    <string name="how_4">Civilians win by voting out every impostor. Impostors win if only one civilian is left. The Drifter can also win by guessing the word when voted out.</string>

